<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mac App Store entitlements for lailaisay.app (com.yikai.lailaisay).

  App Store review requires App Sandbox. This file is separate from
  lailaisay.entitlements (Developer ID, no sandbox) on purpose: the
  Developer ID build keeps the CGEvent tap + AX/CGEvent paste path, the
  App Store build must use sandbox-safe alternatives (see APP_STORE.md).
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Microphone capture. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Model catalog download and optional Ollama / Groq / Gemini polish. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- User-picked ggml/gguf model files via the open panel. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
</dict>
</plist>
