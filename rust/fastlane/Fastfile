# lailaisay Mac App Store lanes. Run from rust/: `fastlane mac <lane>`.
# Adapted from PilotApp_Flutter_Standalone/ios/fastlane/Fastfile.
#
# Prerequisites (see ../APP_STORE.md):
#   - App Store Connect API key .p8 at the repository root (git-ignored, never commit),
#     or point ASC_KEY_PATH at it.
#   - dist/lailaisay.pkg produced by the App Store packaging steps.
default_platform(:mac)

ROOT = File.expand_path("../..", __dir__) # repository root
KEY_PATH = ENV.fetch("ASC_KEY_PATH", File.join(ROOT, "AuthKey_7AXGRN3B24.p8"))
KEY_ID = ENV.fetch("ASC_KEY_ID", "7AXGRN3B24")
ISSUER_ID = ENV.fetch("ASC_ISSUER_ID", "69a6de7f-8267-47e3-e053-5b8c7c11a4d1")
BUNDLE_ID = "com.yikai.lailaisay"
PKG_PATH = File.expand_path("../dist/lailaisay.pkg", __dir__)
PLIST_PATH = File.expand_path("../macos/Info.plist", __dir__)

def marketing_version
  `/usr/libexec/PlistBuddy -c 'Print CFBundleShortVersionString' "#{PLIST_PATH}"`.strip
end

# Lazy so `fastlane lanes` works before the .p8 is in place.
def api_key
  UI.user_error!("App Store Connect API key not found at #{KEY_PATH} (set ASC_KEY_PATH)") unless File.exist?(KEY_PATH)
  @api_key ||= app_store_connect_api_key(
    key_id: KEY_ID,
    issuer_id: ISSUER_ID,
    key_filepath: KEY_PATH,
    in_house: false
  )
end

def latest_asc_build
  require "spaceship"
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
    key_id: KEY_ID, issuer_id: ISSUER_ID, filepath: KEY_PATH
  )
  app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
  UI.user_error!("App Store Connect has no app for #{BUNDLE_ID}; create it first (APP_STORE.md)") unless app
  builds = app.get_builds(filter: { "preReleaseVersion.platform" => "MAC_OS" })
  builds.any? ? builds.first.version.to_i : 0
end

platform :mac do
  desc "Compare the newest build on App Store Connect with macos/Info.plist CFBundleVersion"
  lane :check_version do
    latest = latest_asc_build
    local = sh("/usr/libexec/PlistBuddy -c 'Print CFBundleVersion' ../macos/Info.plist", log: false).strip.to_i
    UI.message("App Store Connect: #{latest}  local CFBundleVersion: #{local}")
    if local <= latest && !ENV["SKIP_VERSION_CHECK"]
      UI.user_error!("CFBundleVersion #{local} is not greater than #{latest}; bump macos/Info.plist")
    end
    UI.success("Version check passed: #{local}")
  end

  desc "Upload dist/lailaisay.pkg to TestFlight (internal testers)"
  lane :beta do
    check_version
    UI.user_error!("Missing #{PKG_PATH}") unless File.exist?(PKG_PATH)
    upload_to_testflight(
      api_key: api_key,
      pkg: PKG_PATH,
      app_platform: "osx",
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "Upload dist/lailaisay.pkg plus fastlane/metadata to App Store Connect (no review submission)"
  lane :release do
    check_version
    UI.user_error!("Missing #{PKG_PATH}") unless File.exist?(PKG_PATH)
    upload_to_app_store(
      api_key: api_key,
      pkg: PKG_PATH,
      platform: "osx",
      app_version: marketing_version,
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      skip_screenshots: !Dir.exist?(File.join(__dir__, "screenshots")),
      force: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      submit_for_review: false,
      automatic_release: false
    )
  end

  desc "Submit the uploaded build for review"
  lane :submit_review do
    upload_to_app_store(
      api_key: api_key,
      platform: "osx",
      app_version: marketing_version,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      submit_for_review: true,
      automatic_release: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      }
    )
  end
end
